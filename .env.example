# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Copia este archivo a `.env` y pega tu connection string de Neon.
DATABASE_URL="postgresql://TU_USUARIO:TU_PASSWORD@TU_HOST.neon.tech/iven?sslmode=require"

# Genera el secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Resend (envío de email de verificación). Sin ella, el registro auto-verifica el correo.
RESEND_API_KEY=""
EMAIL_FROM="GameVault <onboarding@resend.dev>"

# Google OAuth. Sin ellas, el botón de Google no se muestra.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AUTH_TRUST_HOST=true es necesario en Vercel y en entornos que no sean localhost.
AUTH_TRUST_HOST="true"

# rawg.io — catálogo de juegos. https://rawg.io → Settings → API
RAWG_API_KEY=""

# Stripe (suscripciones). Sin ellas, la página de facturación queda deshabilitada.
# STRIPE_SECRET_KEY: https://dashboard.stripe.com/apikeys (sk_...)
# STRIPE_WEBHOOK_SECRET: `stripe listen --forward-to localhost:3000/api/stripe/webhook` (whsec_...)
# STRIPE_PRICE_PRO / STRIPE_PRICE_COLLECTOR: ids de los precios recurrentes
# (Productos → Precio, p.ej. "price_...").
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_COLLECTOR=""

# Mercado Pago (suscripciones). Proveedor alternativo para LATAM; sin estas
# variables solo se ofrece Stripe.
# MP_TEST_ACCESS_TOKEN / MP_ACCESS_TOKEN: https://www.mercadopago.com.ar/developers → Credenciales
# MP_WEBHOOK_SECRET: secret de suscripción de webhooks (para verificar x-signature).
# MP_PREAPPROVAL_PLAN_PRO / MP_PREAPPROVAL_PLAN_COLLECTOR: ids de los planes
# recurrentes creados en la API de Preapproval (crear preapproval_plan con
# auto_recurring: frequency 1, frequency_type "months", currency_id y
# transaction_amount = lo que pongas en MP_PRICE_*).
# MP_CURRENCY_ID: moneda del plan (ej. MXN, ARS, BRL, COP...).
# MP_PRICE_PRO / MP_PRICE_COLLECTOR: importe en la moneda, con decimales (ej. 99.00).
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_CURRENCY_ID=""
MP_PREAPPROVAL_PLAN_PRO=""
MP_PREAPPROVAL_PLAN_COLLECTOR=""
MP_PRICE_PRO=""
MP_PRICE_COLLECTOR=""