// GameVault — base de datos de inventario para coleccionistas
// Prisma 7 (prisma-client generator + driver adapter)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// Medios de pago de la pasarela. Los valores son los del campo `provider` de
// `src/lib/billing.ts`: la BD los valida, así que nadie puede inventarse un
// proveedor ni meter filas basura.
enum PaymentProvider {
  stripe
  mp
}

enum GameStatus {
  OWNED
  SEALED
  CIB
  LOOSE
  DIGITAL
  WISHLIST
  SELLING
}

model Plan {
  slug       String   @id
  nameEs     String
  nameEn     String
  gameLimit  Int?
  imageLimit Int      @default(1)
  paid       Boolean  @default(false)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
}

model Platform {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]

  @@index([slug])
}

// Interruptor de cada medio de pago, editable desde el admin. Solo guarda el
// "lo quiere el admin": que el proveedor esté disponible sigue exigiendo sus
// variables de entorno (ver `src/lib/payment-providers.ts`). Si no hay fila, el
// proveedor se considera habilitado.
model PaymentProviderSetting {
  provider  PaymentProvider @id
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String?
  name                 String?
  imageUrl             String?
  emailVerifiedAt      DateTime?
  role                 String               @default("user")
  bannedAt             DateTime?
  plan                 String               @default("FREE")
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  subscriptionStatus   SubscriptionStatus?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // Mercado Pago (Checkout Pro sobre Orders API, con redirección). El pago
  // ocurre en el-hosted checkout de MP y NO guarda tarjeta: no hay customer,
  // ni payment profile, ni cobros automáticos. Cada ciclo el usuario vuelve a
  // pagar (ver `src/lib/mp.ts`).
  //
  // Inicio del último periodo pagado. Es el ancla del ciclo: el barrido diario
  // (`/api/mp/expire`) degrada a FREE a quien lo tenga vencido, porque nadie
  // renueva solo (MP no agenda cobros). Un pago aprobado lo actualiza el webhook
  // `order`; nunca la vuelta del usuario desde la return URL.
  mpLastChargeAt DateTime?

  games    Game[]
  sessions Session[]
  accounts Account[]

  @@index([mpLastChargeAt])
}

model Game {
  id         String     @id @default(cuid())
  userId     String
  title      String
  platformId String
  genre      String?
  status     GameStatus @default(OWNED)
  condition  String?
  purchasePrice Decimal?   @db.Decimal(10, 2)
  purchaseDate  DateTime?
  notes         String?
  coverImageUrl String?
  rawgId        String?
  playtimeMin   Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform   @relation(fields: [platformId], references: [id], onDelete: Restrict)
  images   GameImage[]

  @@index([userId])
  @@index([platformId])
  @@index([status])
}

model GameImage {
  id        String   @id @default(cuid())
  gameId    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, position])
}

// ---- Tablas para el adapter de Auth.js (NextAuth v5) ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}